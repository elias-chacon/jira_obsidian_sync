JIRA_BASE_URL=https://empresa.atlassian.net
JIRA_EMAIL=usuario@empresa.com
JIRA_API_TOKEN=TOKEN
OBSIDIAN_BOARD_FILE=C:\Users\usuario\Documents\Obsidian\vault\Squad\PROJETO\Kanban.md
JIRA_VERIFY_TLS=true
LOG_LEVEL=INFO
# Sincronização Jira → Obsidian (opcional). 0 desativa.
JIRA_PULL_INTERVAL_SECONDS=60
JIRA_PROJECT_KEY=PROJ
# Responsáveis separados por ";" (opcional).
JIRA_USERS="Nome Sobrenome;Outro Nome"
# JQL adicional combinada com AND (opcional), ex.: resolution is EMPTY
JIRA_JQL_EXTRA=
